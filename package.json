{
  "name": "ai-everything",
  "displayName": "AI Everything",
  "shortDescription": "AI Everything toolkits",
  "version": "1.0.0",
  "description": "AI Everything is a collection of skills and tools that can be used to automate your workflow.",
  "author": {
    "name": "jShow",
    "email": "dev@jshow.org"
  },
  "homepage": "https://github.com/j-show/ai-everything",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-show/ai-everything.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "npm run init:darwin",
    "init:darwin": "npx skills add alchaincyf/darwin-skill",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:project": "npm run deploy -t project",
    "deploy:agent": "npm run deploy -t agent",
    "deploy:cursor": "npm run deploy -t cursor",
    "deploy:codex": "npm run deploy -t codex",
    "deploy:claude": "npm run deploy -t claude",
    "deploy:qcode": "npm run deploy -t qcode",
    "upgrade:skill": "node scripts/upgrade-skill.mjs",
    "upgrade:rule": "node scripts/upgrade-rule.mjs",
    "upgrade:design": "npm run upgrade:skill -- --design",
    "upgrade:mattpocock": "npm run upgrade:skill -- --mattpocock",
    "upgrade:superpower": "npm run upgrade:skill -- --superpower"
  },
  "devDependencies": {
    "tar": "^7.5.22"
  }
}